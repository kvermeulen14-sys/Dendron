# Kopieer dit bestand naar .env.local en vul je eigen waarden in.
# Zet deze waarden NOOIT in git - .env* staat al in .gitignore.

# Supabase (Project Settings -> API)
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# Alleen server-side gebruikt (service_role key) - nooit naar de client sturen!
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Gemini / Google AI (aistudio.google.com/apikey -> API Keys)
GEMINI_API_KEY=your-gemini-api-key
# Optioneel: model overschrijven (standaard gemini-2.5-flash)
GEMINI_MODEL=gemini-2.5-flash
